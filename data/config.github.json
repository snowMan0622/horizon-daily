{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "languages": ["zh"],
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": { "threshold": 5.0, "topic_dedup": true },
      "tech-blog": { "threshold": 4.5, "topic_dedup": false },
      "ai-creator": { "threshold": 5.0, "topic_dedup": true }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "placeholder@example.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "webhook": { "enabled": false },
  "wechat": { "enabled": false },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 25,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      { "name": "量子位", "url": "https://wechat2rss.xlab.app/feed/7131b577c61365cb47e81000738c10d872685908.xml", "enabled": true, "category": "ai-news", "profile": "tech-news" },
      { "name": "新智元", "url": "https://wechat2rss.xlab.app/feed/ede30346413ea70dbef5d485ea5cbb95cca446e7.xml", "enabled": true, "category": "ai-news", "profile": "tech-news" },
      { "name": "GitHub Trending 日榜", "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml", "enabled": true, "category": "devtools", "profile": "tech-news" },
      { "name": "GitHub Trending 周榜", "url": "https://mshibanami.github.io/GitHubTrendingRSS/weekly/all.xml", "enabled": true, "category": "devtools", "profile": "tech-news" },
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-tools", "profile": "tech-blog", "content_extractor": "trafilatura" },
      { "name": "阮一峰 科技爱好者周刊", "url": "https://www.ruanyifeng.com/blog/atom.xml", "enabled": true, "category": "devtools", "profile": "tech-blog", "content_extractor": "trafilatura" },
      { "name": "少数派", "url": "https://sspai.com/feed", "enabled": true, "category": "software", "profile": "tech-news", "content_extractor": "trafilatura" },
      { "name": "爱范儿", "url": "https://www.ifanr.com/feed", "enabled": true, "category": "software", "profile": "tech-news", "content_extractor": "trafilatura" },
      { "name": "小众软件", "url": "https://www.appinn.com/feed/", "enabled": true, "category": "software", "profile": "tech-news" },
      { "name": "Solidot 奇客", "url": "https://www.solidot.org/index.rss", "enabled": true, "category": "tech-news", "profile": "tech-news" },
      { "name": "IT之家", "url": "https://www.ithome.com/rss/", "enabled": true, "category": "software", "profile": "tech-news" },
      { "name": "Product Hunt", "url": "https://www.producthunt.com/feed", "enabled": true, "category": "ai-tools", "profile": "tech-news" }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "MachineLearning", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 12, "min_score": 60, "profile": "tech-news" },
        { "subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 12, "min_score": 60, "profile": "tech-news" },
        { "subreddit": "SideProject", "enabled": true, "sort": "top", "time_filter": "day", "fetch_limit": 10, "min_score": 30, "profile": "tech-news" },
        { "subreddit": "selfhosted", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 100, "profile": "tech-news" }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": true,
      "channels": [
        { "channel": "zaihuapd", "enabled": true, "fetch_limit": 20, "profile": "tech-news" }
      ]
    },
    "github": [],
    "twitter": { "enabled": false },
    "openbb": { "enabled": false },
    "ossinsight": { "enabled": false },
    "gdelt": { "enabled": false },
    "google_news": { "enabled": false }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 15,
    "profile_order": ["tech-news", "tech-blog", "ai-creator"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": 6
  }
}
